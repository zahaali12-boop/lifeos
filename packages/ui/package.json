{
  "name": "@quicker/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Quicker design system: tokens (light/dark, AA pairs, Arabic-capable type), Radix-based components, RTL by construction (ADR-0013)",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\"",
