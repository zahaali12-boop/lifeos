# Copy to .env for local overrides. Docker Compose reads it automatically; `make` targets read the exported values.
# The host port the API is published on by Docker Compose (the web app is told the same); change it when another
# program already answers on 8080 on your machine.
QUICKER_API_PORT=8080
# The trader program's own stack (docker-compose.trader.yml) publishes its app (which carries its API) on this port.
QUICKER_TRADER_WEB_PORT=5174
# The address the trader program is reached at from outside this machine (sign-in with a passkey or security key and
# the links in its messages use it); deploy\windows\share-trader-anywhere.bat writes the Tailscale address here.
QUICKER_TRADER_PUBLIC_ORIGIN=http://localhost:5174
# This machine's address on the local network, so a phone on the same Wi-Fi can open the full system's app (its API's
# allowed origins and the address its web app calls); the trader program needs it not. Leave localhost otherwise.
QUICKER_LAN_HOST=localhost
# Database (owner runs migrations; app is what the product uses)
Quicker__Db__OwnerConnection=Host=localhost;Port=5432;Database=quicker;Username=quicker_owner;Password=quicker
Quicker__Db__AppConnection=Host=localhost;Port=5432;Database=quicker;Username=quicker_app;Password=quicker
# Tests: owner connection to any database on the cluster (per-class databases are created from a template)
QUICKER_TEST_CONNECTION=Host=127.0.0.1;Port=5432;Database=postgres;Username=quicker_owner;Password=quicker
# Object storage (S3 API)
Quicker__Storage__Endpoint=http://localhost:9000
Quicker__Storage__AccessKey=quicker
Quicker__Storage__SecretKey=quickerquicker
Quicker__Storage__Bucket=quicker
# Email (Mailpit locally)
Quicker__Email__SmtpHost=localhost
Quicker__Email__SmtpPort=1025
# Audit chain anchors (append-only file store; the object-lock store arrives with the storage client)
Quicker__Audit__Anchoring__Store=file
Quicker__Audit__Anchoring__Path=.data/audit-anchors
