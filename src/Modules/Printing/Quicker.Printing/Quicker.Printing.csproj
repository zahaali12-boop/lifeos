<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Printing module: Scriban HTML templates per document type and variant, versioned per tenant; renders by headless Chromium in the worker with a fingerprint cache and an evidence copy under retention; email with the PDF attached (ADR-0022).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Scriban" />
    <ProjectReference Include="../Quicker.Printing.Contracts/Quicker.Printing.Contracts.csproj" />
    <ProjectReference Include="../../Audit/Quicker.Audit.Contracts/Quicker.Audit.Contracts.csproj" />
    <ProjectReference Include="../../Collaboration/Quicker.Collaboration.Contracts/Quicker.Collaboration.Contracts.csproj" />
    <ProjectReference Include="../../Identity/Quicker.Identity.Contracts/Quicker.Identity.Contracts.csproj" />
    <ProjectReference Include="../../Organization/Quicker.Organization.Contracts/Quicker.Organization.Contracts.csproj" />
    <ProjectReference Include="../../Partners/Quicker.Partners.Contracts/Quicker.Partners.Contracts.csproj" />
    <ProjectReference Include="../../Tenancy/Quicker.Tenancy.Contracts/Quicker.Tenancy.Contracts.csproj" />
    <ProjectReference Include="../../../Kernel/Quicker.Kernel/Quicker.Kernel.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Quicker.Messaging/Quicker.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Quicker.Persistence/Quicker.Persistence.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Quicker.Storage/Quicker.Storage.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/Quicker.Web/Quicker.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/*.html;Templates/*.css;Templates/*.json" LogicalName="templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Templates/fonts/*.ttf" LogicalName="fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
