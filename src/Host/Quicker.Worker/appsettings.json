{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Quicker": {
    "Db": {
      "OwnerConnection": "Host=localhost;Port=5432;Database=quicker;Username=quicker_owner;Password=quicker",
      "AppConnection": "Host=localhost;Port=5432;Database=quicker;Username=quicker_app;Password=quicker",
      "StatementTimeoutSeconds": 15,
      "LockTimeoutSeconds": 5
    },
    "Worker": {
      "PollIntervalSeconds": 2,
      "JobConcurrency": 4,
      "SchedulerTickSeconds": 30
    }
  }
}
